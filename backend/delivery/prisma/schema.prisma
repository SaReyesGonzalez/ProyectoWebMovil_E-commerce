generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repartidor {
  id     Int     @id @default(autoincrement())
  userId      Int     @unique     //id del usuario al que referencia este Repartidores
  calificacion    Float?
}